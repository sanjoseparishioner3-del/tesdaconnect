# Public Supabase configuration (safe to bundle; never put SERVICE_ROLE keys here)
VITE_APP_NAME="TCTESDAConnect"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional Sentry error tracking (leave empty to disable)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"

# Offline shared-device guardrails
VITE_OFFLINE_MAX_TTL_HOURS="12"
