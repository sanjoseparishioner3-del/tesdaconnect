# Public Supabase configuration (safe to bundle; never put SERVICE_ROLE keys here)
VITE_APP_NAME="TCTESDAConnect"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
# Preferred: the publishable key (sb_publishable_...). Public by design; never use a secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Optional Sentry error tracking (leave empty to disable)
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"

# Offline shared-device guardrails
VITE_OFFLINE_MAX_TTL_HOURS="12"
# Scholars/applicants often study where there is no signal: their offline window is longer
# (read-mostly personal data) and slides forward every time the app reaches the server.
VITE_LEARNER_OFFLINE_TTL_HOURS="168"
